# Safe demo mode is the default. Set to false only after cloud setup and operator testing.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project URL and anon/publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never commit them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POS_STORE_ID=

# Paystack test/live secret. Start with test keys; merchant onboarding and channel support vary by country.
PAYSTACK_SECRET_KEY=
PAYSTACK_DEFAULT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional managed receipt email. Server-side only; sender domain must be verified with Resend.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=
