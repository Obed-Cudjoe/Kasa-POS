# Next.js build-time UI mode. Keep true until a D1 staging database, auth email, and Worker binding are configured.
NEXT_PUBLIC_DEMO_MODE=true

# Runtime resources are bound by Cloudflare, not configured in this file.
# - D1: binding DB in wrangler.jsonc (add the Cloudflare database_id after creating the database)
# - Worker variables: PUBLIC_APP_URL, RESEND_FROM_EMAIL
# - Worker secrets: SESSION_SECRET (32+ chars), RESEND_API_KEY
# No payment gateway secret is needed for the current cash-only checkout.
# Never place secrets, API keys, passwords, or tokens in this file or in NEXT_PUBLIC_* variables.

# For local Wrangler Worker preview, use the ignored .dev.vars file. For deployment, set values in
# Cloudflare Workers → Settings → Variables and Secrets (and use `wrangler secret put` for secrets).
