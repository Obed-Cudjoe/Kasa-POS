+
+function upsertClause(columns: string[], updates: string[]) {
+  return `ON CONFLICT (${columns.map((name) => `"${name}"`).join(', ')}) DO UPDATE SET ${updates.map((name) => `"${name}" = excluded."${name}"`).join(', ')}`
