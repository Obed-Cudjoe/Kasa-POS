+++ b/src/app/api/auth/accept-invite/route.ts
@@ -0,0 +1,74 @@
+import bcrypt from 'bcryptjs'
+import { assertSameOrigin, hashSecret, HttpError, sessionCookie } from '@/lib/cloud'
+import { consumeAuthRateLimit, isValidPassword, randomToken, readAuthJson } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const body = await readAuthJson(request) as { token?: unknown; password?: unknown }
+    const token = typeof body?.token === 'string' ? body.token : ''
+    if (token.length < 30 || token.length > 100 || !isValidPassword(body?.password)) {
+      throw new HttpError(400, 'Invitation link is invalid or expired, or the password is too short.')
+    }
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Staff account activation is not configured.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'invite-accept-ip', '', 40, 15 * 60_000, 'ip')
+    const tokenAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'invite-accept-token', await hashSecret(token), 8, 15 * 60_000, 'email')
+    if (!ipAllowed || !tokenAllowed) throw new HttpError(429, 'Too many activation attempts. Request a fresh invitation later.')
+    const now = new Date().toISOString()
+    const tokenHash = await hashSecret(token)
+    const invite = await env.DB.prepare(`SELECT t.id AS token_id, t.email, t.employee_id, t.store_id,
+        e.display_name, e.role, e.status, e.refund_limit_minor, s.name AS store_name
+      FROM auth_email_tokens t
+      JOIN employees e ON e.id = t.employee_id AND e.store_id = t.store_id
+      JOIN stores s ON s.id = t.store_id
+      WHERE t.token_hash = ? AND t.purpose = 'invite' AND t.used_at IS NULL AND t.expires_at > ?`)
+      .bind(tokenHash, now).first<{
+        token_id: string; email: string; employee_id: string; store_id: string; display_name: string;
+        role: string; status: string; refund_limit_minor: number | null; store_name: string;
+      }>()
+    if (!invite || invite.status !== 'invited' || !['manager','cashier'].includes(invite.role)) {
+      throw new HttpError(400, 'Invitation link is invalid, expired, or already used. Ask the owner to send a fresh invitation.')
+    }
+    const existing = await env.DB.prepare('SELECT id FROM auth_users WHERE email = ? COLLATE NOCASE').bind(invite.email).first<{ id: string }>()
+    if (existing) throw new HttpError(409, 'This email already has an account. Contact the store owner for help linking access.')
+
+    const userId = crypto.randomUUID()
+    const passwordHash = await bcrypt.hash(body.password, 10)
+    const sessionToken = randomToken()
+    const sessionHash = await hashSecret(sessionToken)
+    const sessionId = crypto.randomUUID()
+    const expires = new Date(Date.now() + 7 * 24 * 60 * 60_000).toISOString()
+    const results = await env.DB.batch([
+      env.DB.prepare(`INSERT INTO auth_users (id, email, display_name, password_hash, status, platform_role, email_verified_at, created_at, updated_at)
+        SELECT ?, ?, ?, ?, 'active', 'user', ?, ?, ?
+        WHERE EXISTS (SELECT 1 FROM auth_email_tokens t JOIN employees e ON e.id = t.employee_id AND e.store_id = t.store_id
+          WHERE t.id = ? AND t.purpose = 'invite' AND t.used_at IS NULL AND t.expires_at > ? AND e.status = 'invited' AND e.email = ? COLLATE NOCASE)`)
+        .bind(userId, invite.email, invite.display_name, passwordHash, now, now, now, invite.token_id, now, invite.email),
+      env.DB.prepare(`UPDATE employees SET auth_user_id = ?, status = 'active', updated_at = ?
+        WHERE id = ? AND store_id = ? AND status = 'invited' AND email = ? COLLATE NOCASE`)
+        .bind(userId, now, invite.employee_id, invite.store_id, invite.email),
+      env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE id = ? AND purpose = 'invite' AND used_at IS NULL AND expires_at > ?`)
+        .bind(now, invite.token_id, now),
+      env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE employee_id = ? AND purpose = 'invite' AND used_at IS NULL`)
+        .bind(now, invite.employee_id),
+      env.DB.prepare(`INSERT INTO auth_sessions (id, token_hash, user_id, employee_id, store_id, created_at, expires_at, last_seen_at)
+        VALUES (?, ?, ?, ?, ?, ?, ?, ?)`)
+        .bind(sessionId, sessionHash, userId, invite.employee_id, invite.store_id, now, expires, now),
+    ])
+    if (Number(results[1]?.meta?.changes ?? 0) !== 1 || Number(results[2]?.meta?.changes ?? 0) !== 1) {
+      throw new HttpError(409, 'This invitation was already accepted or has expired. Ask the owner to send a fresh invitation.')
+    }
+    return Response.json({ ok: true, employee: {
+      id: invite.employee_id, storeId: invite.store_id, authUserId: userId,
+      displayName: invite.display_name, email: invite.email, role: invite.role,
+      refundLimitMinor: invite.refund_limit_minor, status: 'active', createdAt: now,
+    } }, { headers: { 'set-cookie': sessionCookie(request, sessionToken), 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return Response.json({ error: 'Invitation could not be activated. Request a fresh invitation and retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
diff --git a/src/app/api/auth/invites/route.ts b/src/app/api/auth/invites/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2ad1cc235deb1bc678fa7a39f913c80cc14c6efd
--- /dev/null
+++ b/src/app/api/auth/invites/route.ts
@@ -0,0 +1,78 @@
+import { authorizeRequest, HttpError, hashSecret } from '@/lib/cloud'
+import { consumeAuthRateLimit, emailLinkBase, escapeHtml, isValidEmail, normalizeEmail, randomToken, readAuthJson, sendAuthEmail } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  try {
+    const actor = await authorizeRequest(request, ['owner'])
+    const body = await readAuthJson(request) as { email?: unknown; displayName?: unknown; role?: unknown; refundLimitMinor?: unknown }
+    const email = normalizeEmail(body?.email)
+    const displayName = typeof body?.displayName === 'string' ? body.displayName.trim() : ''
+    const role = body?.role
+    const refundLimit = body?.refundLimitMinor === undefined ? 0 : body.refundLimitMinor
+    if (!isValidEmail(email) || displayName.length < 2 || displayName.length > 100 || !['manager','cashier'].includes(String(role))) {
+      throw new HttpError(400, 'Enter a valid staff name, email, and manager or cashier role.')
+    }
+    if (!Number.isSafeInteger(refundLimit) || Number(refundLimit) < 0) {
+      throw new HttpError(400, 'Refund limit must be a non-negative safe integer in GHS pesewas.')
+    }
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Staff invitations are not configured.')
+    if (!env.RESEND_API_KEY || !env.RESEND_FROM_EMAIL) throw new HttpError(503, 'Email delivery is not configured.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'staff-invite-ip', '', 40, 60 * 60_000, 'ip')
+    const emailAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'staff-invite-email', email, 8, 60 * 60_000, 'email')
+    if (!ipAllowed || !emailAllowed) throw new HttpError(429, 'Too many invitation attempts for this email. Wait and try again later.')
+    const account = await env.DB.prepare('SELECT id FROM auth_users WHERE email = ? COLLATE NOCASE').bind(email).first<{ id: string }>()
+    if (account) throw new HttpError(409, 'That email already has an account. Ask the staff member to sign in or contact the owner.')
+    const existing = await env.DB.prepare(`SELECT id, status FROM employees WHERE store_id = ? AND email = ? COLLATE NOCASE`)
+      .bind(actor.storeId, email).first<{ id: string; status: string }>()
+    if (existing && existing.status !== 'invited') throw new HttpError(409, 'An active or disabled staff profile already uses that email in this store.')
+    const elsewhere = await env.DB.prepare(`SELECT id FROM employees WHERE email = ? COLLATE NOCASE AND store_id <> ? AND status <> 'disabled'`)
+      .bind(email, actor.storeId).first<{ id: string }>()
+    if (elsewhere) throw new HttpError(409, 'That email is already assigned to another store account.')
+
+    const employeeId = existing?.id ?? crypto.randomUUID()
+    const token = randomToken()
+    const tokenHash = await hashSecret(token)
+    const now = new Date().toISOString()
+    const expires = new Date(Date.now() + 7 * 24 * 60 * 60_000).toISOString()
+    const changes: D1PreparedStatement[] = []
+    if (existing) {
+      changes.push(env.DB.prepare(`UPDATE employees SET display_name = ?, role = ?, status = 'invited', refund_limit_minor = ?, updated_at = ?
+        WHERE store_id = ? AND id = ? AND status = 'invited'`)
+        .bind(displayName, role, Number(refundLimit), now, actor.storeId, employeeId))
+      changes.push(env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE employee_id = ? AND purpose = 'invite' AND used_at IS NULL`)
+        .bind(now, employeeId))
+    } else {
+      changes.push(env.DB.prepare(`INSERT INTO employees (id, store_id, display_name, email, role, status, refund_limit_minor, created_at, updated_at)
+        VALUES (?, ?, ?, ?, ?, 'invited', ?, ?, ?)`)
+        .bind(employeeId, actor.storeId, displayName, email, role, Number(refundLimit), now, now))
+    }
+    changes.push(env.DB.prepare(`INSERT INTO auth_email_tokens (id, purpose, token_hash, email, employee_id, store_id, created_at, expires_at)
+      VALUES (?, 'invite', ?, ?, ?, ?, ?, ?)`)
+      .bind(crypto.randomUUID(), tokenHash, email, employeeId, actor.storeId, now, expires))
+    await env.DB.batch(changes)
+
+    const link = `${emailLinkBase(request, env)}/?invite=${encodeURIComponent(token)}`
+    const safeName = escapeHtml(displayName)
+    const store = await env.DB.prepare('SELECT name FROM stores WHERE id = ?').bind(actor.storeId).first<{ name: string }>()
+    const storeName = store?.name ?? 'your store'
+    await sendAuthEmail(env, email, `Invitation to join ${storeName} on Kasa POS`,
+      `Hello ${displayName},\n\n${actor.displayName} invited you to join ${storeName} as a ${String(role)}. Open this link within 7 days to set your password and activate your staff profile:\n${link}\n\nIf you were not expecting this invitation, ignore this email.`,
+      `<p>Hello ${safeName},</p><p>${escapeHtml(actor.displayName)} invited you to join <strong>${escapeHtml(storeName)}</strong> as a ${escapeHtml(String(role))}.</p><p><a href="${escapeHtml(link)}">Accept staff invitation</a></p><p>This invitation expires in 7 days. If you were not expecting it, ignore this message.</p>`)
+
+    return Response.json({ ok: true, employee: {
+      id: employeeId, storeId: actor.storeId, displayName, email, role, status: 'invited',
+      refundLimitMinor: Number(refundLimit), createdAt: existing ? undefined : now,
+    } }, { status: existing ? 200 : 201, headers: { 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    if (error instanceof Error && /sign in|session has expired|permission|role does not/i.test(error.message)) {
+      const status = /permission|role does not/i.test(error.message) ? 403 : 401
+      return Response.json({ error: error.message }, { status, headers: { 'cache-control': 'no-store' } })
+    }
+    return Response.json({ error: 'Staff invitation could not be created. Please retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
diff --git a/src/app/api/auth/login/route.ts b/src/app/api/auth/login/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..38f1b514884144dd74566b03e946bf75ea126d29
--- /dev/null
+++ b/src/app/api/auth/login/route.ts
@@ -0,0 +1,52 @@
+import bcrypt from 'bcryptjs'
+import { assertSameOrigin, HttpError, sessionTokenFromRequest } from '@/lib/cloud'
+import { consumeAuthRateLimit, createSession, isValidEmail, normalizeEmail, readAuthJson } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+const DUMMY_PASSWORD_HASH = '$2b$10$ODY2oqWIgRk9izyxu2yXiOIF6Oi0B3VrVkUEedBMStg6E7WLr02Ru'
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const body = await readAuthJson(request) as { email?: unknown; password?: unknown }
+    const email = normalizeEmail(body?.email)
+    const password = typeof body?.password === 'string' ? body.password : ''
+    if (!isValidEmail(email) || password.length < 1 || password.length > 128) {
+      throw new HttpError(400, 'Enter a valid email address and password.')
+    }
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Cloud sign-in is not configured on this deployment.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'login-ip', '', 40, 15 * 60_000, 'ip')
+    const accountAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'login-email', email, 10, 15 * 60_000, 'email')
+    if (!ipAllowed || !accountAllowed) throw new HttpError(429, 'Too many sign-in attempts. Wait a little while and try again.')
+
+    const user = await env.DB.prepare('SELECT id, email, password_hash, status, email_verified_at FROM auth_users WHERE email = ? COLLATE NOCASE')
+      .bind(email).first<{ id: string; email: string; password_hash: string; status: string; email_verified_at: string | null }>()
+    const passwordMatches = await bcrypt.compare(password, user?.password_hash ?? DUMMY_PASSWORD_HASH).catch(() => false)
+    if (!user || !passwordMatches || user.status !== 'active' || !user.email_verified_at) {
+      return Response.json({ error: 'Email/password is incorrect or the email address has not been verified.' }, { status: 401, headers: { 'cache-control': 'no-store' } })
+    }
+    const employee = await env.DB.prepare(`SELECT e.id, e.store_id FROM employees e
+        JOIN stores s ON s.id = e.store_id
+      WHERE e.auth_user_id = ? AND e.status = 'active'`)
+      .bind(user.id).first<{ id: string; store_id: string }>()
+    if (!employee) return Response.json({ error: 'Email/password is incorrect or the email address has not been verified.' }, { status: 401, headers: { 'cache-control': 'no-store' } })
+
+    const session = await createSession(env.DB, request, user.id, employee.id, employee.store_id)
+    // A successful login replaces the current browser session, not other device sessions.
+    const oldToken = sessionTokenFromRequest(request)
+    if (oldToken) {
+      const { hashSecret } = await import('@/lib/cloud')
+      await env.DB.prepare('UPDATE auth_sessions SET revoked_at = ? WHERE token_hash = ? AND revoked_at IS NULL')
+        .bind(new Date().toISOString(), await hashSecret(oldToken)).run()
+    }
+    return Response.json({ ok: true }, {
+      headers: { 'set-cookie': session.cookie, 'cache-control': 'no-store' },
+    })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return Response.json({ error: 'Sign-in could not be completed. Please retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
