--- /dev/null
+++ b/src/app/api/auth/password/forgot/route.ts
@@ -0,0 +1,44 @@
+import { assertSameOrigin, HttpError, hashSecret } from '@/lib/cloud'
+import { consumeAuthRateLimit, emailLinkBase, escapeHtml, isValidEmail, normalizeEmail, randomToken, readAuthJson, sendAuthEmail } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const body = await readAuthJson(request) as { email?: unknown }
+    const email = normalizeEmail(body?.email)
+    if (!isValidEmail(email)) throw new HttpError(400, 'Enter a valid email address.')
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Password recovery is not configured.')
+    if (!env.RESEND_API_KEY || !env.RESEND_FROM_EMAIL) throw new HttpError(503, 'Email delivery is not configured.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'password-reset-ip', '', 30, 60 * 60_000, 'ip')
+    const emailAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'password-reset-email', email, 5, 60 * 60_000, 'email')
+    if (!ipAllowed || !emailAllowed) throw new HttpError(429, 'Too many password-recovery requests. Please wait and try again.')
+    const user = await env.DB.prepare(`SELECT id, display_name, status, email_verified_at FROM auth_users WHERE email = ? COLLATE NOCASE`)
+      .bind(email).first<{ id: string; display_name: string; status: string; email_verified_at: string | null }>()
+    if (user?.status === 'active' && user.email_verified_at) {
+      const token = randomToken()
+      const tokenHash = await hashSecret(token)
+      const now = new Date().toISOString()
+      const expires = new Date(Date.now() + 30 * 60_000).toISOString()
+      await env.DB.batch([
+        env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE user_id = ? AND purpose = 'reset' AND used_at IS NULL`).bind(now, user.id),
+        env.DB.prepare(`INSERT INTO auth_email_tokens (id, purpose, token_hash, email, user_id, created_at, expires_at)
+          VALUES (?, 'reset', ?, ?, ?, ?, ?)`)
+          .bind(crypto.randomUUID(), tokenHash, email, user.id, now, expires),
+      ])
+      const base = emailLinkBase(request, env)
+      const link = `${base}/?reset=${encodeURIComponent(token)}`
+      const displayName = escapeHtml(user.display_name)
+      await sendAuthEmail(env, email, 'Reset your Kasa POS password',
+        `Hello ${user.display_name},\n\nChoose a new password within 30 minutes:\n${link}\n\nIf you did not request this, ignore the message.`,
+        `<p>Hello ${displayName},</p><p>A password reset was requested for your Kasa POS account.</p><p><a href="${escapeHtml(link)}">Choose a new password</a></p><p>This link expires in 30 minutes. If you did not request this, ignore this message.</p>`)
+    }
+    return Response.json({ ok: true, message: 'If an active account matches that address, a password-reset link has been sent.' }, { status: 202, headers: { 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return Response.json({ error: 'Password-recovery email could not be sent. Please retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
diff --git a/src/app/api/auth/password/reset/route.ts b/src/app/api/auth/password/reset/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d19a8522e939e195fef195a55081331a457de06c
--- /dev/null
+++ b/src/app/api/auth/password/reset/route.ts
@@ -0,0 +1,46 @@
+import bcrypt from 'bcryptjs'
+import { assertSameOrigin, hashSecret, HttpError } from '@/lib/cloud'
+import { consumeAuthRateLimit, isValidPassword, readAuthJson } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const body = await readAuthJson(request) as { token?: unknown; password?: unknown }
+    const token = typeof body?.token === 'string' ? body.token : ''
+    if (token.length < 30 || token.length > 100 || !isValidPassword(body?.password)) {
+      throw new HttpError(400, 'The reset link is invalid or expired, or the new password is too short.')
+    }
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Password recovery is not configured.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'password-reset-submit-ip', '', 40, 15 * 60_000, 'ip')
+    const tokenAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'password-reset-submit-token', await hashSecret(token), 8, 15 * 60_000, 'email')
+    if (!ipAllowed || !tokenAllowed) throw new HttpError(429, 'Too many password-reset attempts. Request a fresh link later.')
+    const tokenHash = await hashSecret(token)
+    const now = new Date().toISOString()
+    const reset = await env.DB.prepare(`SELECT id, user_id FROM auth_email_tokens
+      WHERE token_hash = ? AND purpose = 'reset' AND used_at IS NULL AND expires_at > ? AND user_id IS NOT NULL`)
+      .bind(tokenHash, now).first<{ id: string; user_id: string }>()
+    if (!reset) throw new HttpError(400, 'The reset link is invalid or expired. Request a fresh link.')
+    const passwordHash = await bcrypt.hash(body.password, 10)
+    const results = await env.DB.batch([
+      env.DB.prepare(`UPDATE auth_users SET password_hash = ?, updated_at = ?
+        WHERE id = ? AND status = 'active' AND EXISTS (
+          SELECT 1 FROM auth_email_tokens WHERE id = ? AND user_id = ? AND purpose = 'reset' AND used_at IS NULL AND expires_at > ?)`)
+        .bind(passwordHash, now, reset.user_id, reset.id, reset.user_id, now),
+      env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE id = ? AND user_id = ? AND purpose = 'reset' AND used_at IS NULL AND expires_at > ?`)
+        .bind(now, reset.id, reset.user_id, now),
+      env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE user_id = ? AND purpose = 'reset' AND used_at IS NULL`)
+        .bind(now, reset.user_id),
+      env.DB.prepare('UPDATE auth_sessions SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL')
+        .bind(now, reset.user_id),
+    ])
+    if (Number(results[0]?.meta?.changes ?? 0) !== 1) throw new HttpError(400, 'The reset link is invalid or expired. Request a fresh link.')
+    return Response.json({ ok: true, message: 'Password changed. Sign in with your new password.' }, { headers: { 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return Response.json({ error: 'Password could not be changed. Request a fresh reset link and retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
diff --git a/src/app/api/auth/register/route.ts b/src/app/api/auth/register/route.ts
