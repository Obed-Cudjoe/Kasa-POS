-  v_type text := p_movement->>'movementType';
-  v_delta numeric(14,3) := (p_movement->>'quantityDelta')::numeric;
-  v_base bigint := nullif(p_movement->>'baseVersion','')::bigint;
-  v_current_version bigint;
-  v_new_quantity numeric(14,3);
-  v_rows integer;
