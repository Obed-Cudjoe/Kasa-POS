diff --git a/src/app/api/auth/verification/resend/route.ts b/src/app/api/auth/verification/resend/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44559cf840343229a75fbfade3ebdcccbdb24b11
--- /dev/null
+++ b/src/app/api/auth/verification/resend/route.ts
@@ -0,0 +1,44 @@
+import { assertSameOrigin, HttpError, hashSecret } from '@/lib/cloud'
+import { consumeAuthRateLimit, emailLinkBase, escapeHtml, normalizeEmail, randomToken, readAuthJson, sendAuthEmail } from '@/lib/auth-service'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const body = await readAuthJson(request) as { email?: unknown }
+    const email = normalizeEmail(body?.email)
+    if (!email || email.length > 254) throw new HttpError(400, 'Enter a valid email address.')
+    const env = await getWorkerEnv()
+    if (!env.DB || !env.SESSION_SECRET) throw new HttpError(503, 'Account email is not configured.')
+    if (!env.RESEND_API_KEY || !env.RESEND_FROM_EMAIL) throw new HttpError(503, 'Email delivery is not configured.')
+    const ipAllowed = await consumeAuthRateLimit(env.DB, request, env, 'verify-resend-ip', '', 30, 60 * 60_000, 'ip')
+    const emailAllowed = ipAllowed && await consumeAuthRateLimit(env.DB, request, env, 'verify-resend-email', email, 4, 60 * 60_000, 'email')
+    if (!ipAllowed || !emailAllowed) throw new HttpError(429, 'Too many email requests. Please wait and try again.')
+    const user = await env.DB.prepare(`SELECT id, display_name, email_verified_at FROM auth_users WHERE email = ? COLLATE NOCASE AND status = 'active'`)
+      .bind(email).first<{ id: string; display_name: string; email_verified_at: string | null }>()
+    if (user && !user.email_verified_at) {
+      const token = randomToken()
+      const tokenHash = await hashSecret(token)
+      const now = new Date().toISOString()
+      const expires = new Date(Date.now() + 24 * 60 * 60_000).toISOString()
+      await env.DB.batch([
+        env.DB.prepare(`UPDATE auth_email_tokens SET used_at = ? WHERE email = ? COLLATE NOCASE AND purpose = 'verify' AND used_at IS NULL`).bind(now, email),
+        env.DB.prepare(`INSERT INTO auth_email_tokens (id, purpose, token_hash, email, user_id, created_at, expires_at)
+          VALUES (?, 'verify', ?, ?, ?, ?, ?)`)
+          .bind(crypto.randomUUID(), tokenHash, email, user.id, now, expires),
+      ])
+      const base = emailLinkBase(request, env)
+      const link = `${base}/api/auth/verify-email?token=${encodeURIComponent(token)}`
+      const name = escapeHtml(user.display_name)
+      await sendAuthEmail(env, email, 'Verify your Kasa POS account',
+        `Hello ${user.display_name},\n\nVerify your email address by opening this link:\n${link}\n\nThis link expires in 24 hours.`,
+        `<p>Hello ${name},</p><p>Verify your email address.</p><p><a href="${escapeHtml(link)}">Verify email address</a></p><p>This link expires in 24 hours.</p>`)
+    }
+    return Response.json({ ok: true, message: 'If this account needs verification, a fresh link has been sent.' }, { status: 202, headers: { 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return Response.json({ error: 'Verification email could not be sent. Please retry.' }, { status: 503, headers: { 'cache-control': 'no-store' } })
+  }
+}
diff --git a/src/app/api/auth/verify-email/route.ts b/src/app/api/auth/verify-email/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ed6901d3d96404ce87ffba62f8e95f796992dfd
--- /dev/null
+++ b/src/app/api/auth/verify-email/route.ts
@@ -0,0 +1,48 @@
+import { assertSameOrigin, hashSecret, HttpError } from '@/lib/cloud'
+import { getWorkerEnv } from '@/lib/d1'
+
+export const dynamic = 'force-dynamic'
+
+const page = (title: string, body: string, status = 200) => new Response(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${title} · Kasa POS</title><body style="font:16px system-ui,sans-serif;background:#f4f7f4;color:#173126;margin:0;padding:8vh 20px"><main style="max-width:520px;margin:auto;background:white;border:1px solid #dce6dd;border-radius:18px;padding:28px"><h1 style="font-size:24px">${title}</h1>${body}</main></body></html>`, {
+  status,
+  headers: {
+    'content-type': 'text/html; charset=utf-8',
+    'cache-control': 'no-store',
+    'content-security-policy': "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
+    'x-content-type-options': 'nosniff',
+    'referrer-policy': 'no-referrer',
+  },
+})
+
+export async function GET(request: Request) {
+  const token = new URL(request.url).searchParams.get('token') ?? ''
+  if (token.length < 30 || token.length > 100) return page('Invalid verification link', '<p>Request a fresh verification email and try again.</p>', 400)
+  const escaped = token.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;')
+  return page('Verify your email', `<p>Confirm that you control this email address to activate your Kasa POS account.</p><form method="post" action="/api/auth/verify-email"><input type="hidden" name="token" value="${escaped}"><button style="border:0;border-radius:10px;padding:12px 18px;background:#176d42;color:white;font-weight:700;cursor:pointer">Verify email address</button></form><p style="color:#5d7064;font-size:13px">This link is single-use and expires after 24 hours.</p>`)
+}
+
+export async function POST(request: Request) {
+  try {
+    assertSameOrigin(request)
+    const form = await request.formData()
+    const token = String(form.get('token') ?? '')
+    if (token.length < 30 || token.length > 100) throw new HttpError(400, 'Verification link is invalid or expired.')
+    const env = await getWorkerEnv()
+    if (!env.DB) throw new HttpError(503, 'Account service is not configured.')
+    const tokenHash = await hashSecret(token)
+    const now = new Date().toISOString()
+    const row = await env.DB.prepare(`SELECT id, user_id FROM auth_email_tokens
+      WHERE token_hash = ? AND purpose = 'verify' AND used_at IS NULL AND expires_at > ? AND user_id IS NOT NULL`)
+      .bind(tokenHash, now).first<{ id: string; user_id: string }>()
+    if (!row) throw new HttpError(400, 'Verification link is invalid or expired. Request a new link.')
+    await env.DB.batch([
+      env.DB.prepare(`UPDATE auth_users SET email_verified_at = COALESCE(email_verified_at, ?), updated_at = ? WHERE id = ? AND status = 'active'`)
+        .bind(now, now, row.user_id),
+      env.DB.prepare('UPDATE auth_email_tokens SET used_at = ? WHERE id = ? AND used_at IS NULL').bind(now, row.id),
+    ])
+    return page('Email verified', '<p>Your email address is verified. You can now sign in to your Kasa POS store.</p><p><a href="/?verified=1" style="color:#176d42;font-weight:700">Return to Kasa POS</a></p>')
+  } catch (error) {
+    if (error instanceof HttpError) return page('Verification could not be completed', `<p>${error.message.replace(/[&<>]/g, '')}</p><p><a href="/">Return to Kasa POS</a></p>`, error.status)
+    return page('Verification could not be completed', '<p>Please request a fresh verification email and retry.</p><p><a href="/">Return to Kasa POS</a></p>', 503)
+  }
+}
diff --git a/src/app/api/employees/role/route.ts b/src/app/api/employees/role/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6dddcdf838c36e8cbae5dd8d2d8602860f69315c
--- /dev/null
+++ b/src/app/api/employees/role/route.ts
@@ -0,0 +1,49 @@
+import { authorizeRequest, HttpError, routeError } from '@/lib/cloud'
+
+export const dynamic = 'force-dynamic'
+
+const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+
+export async function POST(request: Request) {
+  try {
+    const actor = await authorizeRequest(request, ['owner'])
+    const body = await request.json().catch(() => null) as { employeeId?: unknown; displayName?: unknown; role?: unknown; refundLimitMinor?: unknown } | null
+    const employeeId = typeof body?.employeeId === 'string' ? body.employeeId : ''
+    const displayName = typeof body?.displayName === 'string' ? body.displayName.trim() : ''
+    const role = typeof body?.role === 'string' ? body.role : ''
+    const refundLimit = body?.refundLimitMinor
+    if (!UUID_PATTERN.test(employeeId) || displayName.length < 2 || displayName.length > 100 || !['owner','manager','cashier'].includes(role)) {
+      throw new HttpError(400, 'Employee ID, name, or role is invalid.')
+    }
+    if (role === 'owner' && refundLimit !== null && (!Number.isSafeInteger(refundLimit) || Number(refundLimit) < 0)) {
+      throw new HttpError(400, 'An owner refund limit must be a non-negative safe integer or null for no cap.')
+    }
+    if (role !== 'owner' && (!Number.isSafeInteger(refundLimit) || Number(refundLimit) < 0)) {
+      throw new HttpError(400, 'A manager or cashier must have a finite non-negative refund limit in pesewas.')
+    }
+    const { data: target, error: lookupError } = await actor.admin.from('employees')
+      .select('id,role,status').eq('store_id', actor.storeId).eq('id', employeeId).maybeSingle()
+    if (lookupError) throw new Error(lookupError.message)
+    if (!target) throw new HttpError(404, 'Employee was not found in this store.')
+    if (target.status === 'invited') throw new HttpError(409, 'Use the invitation form to update or resend an invited employee.')
+    if (target.role === 'owner' && role !== 'owner') {
+      const { data: owners, error: ownersError } = await actor.admin.from('employees').select('id')
+        .eq('store_id', actor.storeId).eq('role', 'owner').eq('status', 'active')
+      if (ownersError) throw new Error(ownersError.message)
+      if (!Array.isArray(owners) || owners.length <= 1) throw new HttpError(409, 'A store must keep at least one active owner.')
+    }
+    const { data: updated, error: updateError } = await actor.admin.from('employees').update({
+      display_name: displayName,
+      role,
+      refund_limit_minor: role === 'owner' && refundLimit === null ? null : Number(refundLimit),
+      updated_at: new Date().toISOString(),
+    }).eq('store_id', actor.storeId).eq('id', employeeId).eq('status', 'active')
+      .select('id,store_id,auth_user_id,display_name,email,role,status,refund_limit_minor,created_at').maybeSingle()
+    if (updateError) throw new Error(updateError.message)
+    if (!updated) throw new HttpError(409, 'Employee profile changed; refresh and try again.')
+    return Response.json({ ok: true, employee: updated }, { headers: { 'cache-control': 'no-store' } })
+  } catch (error) {
+    if (error instanceof HttpError) return Response.json({ error: error.message }, { status: error.status, headers: { 'cache-control': 'no-store' } })
+    return routeError(error)
+  }
+}
