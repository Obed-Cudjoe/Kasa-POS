{
  "name": "merchant-pos-pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --ip 0.0.0.0 --port 8787",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@point-of-sale/webbluetooth-receipt-printer": "^2.1.0",
    "@point-of-sale/webusb-receipt-printer": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@serwist/next": "^9.5.13",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.81.1",
    "dexie": "^4.4.6",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.2",
    "serwist": "^9.5.13",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.37.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
